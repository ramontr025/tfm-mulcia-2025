# ─────────────────────────────────────────────────────────────────────────────
# Snakefile: la base del pipeline.
#
# snakemake lee la config, construye unos cuantos mapas que usan las reglas, e incluye
# los archivos de reglas. `rule all` es el objetivo por defecto: lo que pides cuando
# ejecutas `snakemake` sin nombrar un archivo. Ahí ves los endpoints del pipeline.
#
# Ejecuta:
#   pixi run snakemake -n           # dry run: imprime el DAG sin correr nada
#   pixi run snakemake -c4          # corre el pipeline con 4 nucleos
#   pixi run snakemake -c1 results/train/sequences.pkl   # construye un objetivo suelto
# ─────────────────────────────────────────────────────────────────────────────
configfile: "config/config.yaml"


# ── Mapas derivados de la config que usan las reglas ──
SPLITS = ["train", "val", "holdout"]
LANDMARKS = list(
    range(config["cohort"]["landmark_min"], config["cohort"]["landmark_max"] + 1)
)
MODELS = {
    m["name"]: m for m in config.get("models", [])
}  # nombre -> fila del modelo (issues 2 a 5)
# `models:` no existe en la config todavia (llega en el issue 2), de ahi el
# `.get(..., [])`: sin esto, cargar el Snakefile ya revienta antes del issue 1.
BASE_MODELS = list(MODELS)  # los de la config; los que entran en compare y en all
# La ejecucion principal fija su semilla de entrenamiento con la misma semilla de la
# particion (splits.seed): es la replica 0 y sus numeros son los de las tablas.
MAIN_SEED = config["splits"]["seed"]
for m in MODELS.values():
    m["seed"] = MAIN_SEED
# Replicas: cada semilla s da una particion propia de discovery y una semilla de
# entrenamiento propia, y la misma fila de `models:` se entrena como {name}_s{s}
# sobre las secuencias de su replica. Solo las piden las reglas `seeds` y `paired`.
SEEDS = config.get("replica_seeds", [])
assert MAIN_SEED not in SEEDS, "replica_seeds no puede repetir splits.seed"
MODELS.update(
    {
        f"{n}_s{s}": {**m, "name": f"{n}_s{s}", "seed": s, "replica": s}
        for n, m in list(MODELS.items())
        for s in SEEDS
    }
)


def sequences_for(name, split):
    """Secuencias de un split para un modelo: las principales o las de su replica."""
    rep = MODELS[name].get("replica")
    if rep is None:
        return f"results/{split}/sequences.pkl"
    return f"results/replicas/s{rep}/{split}/sequences.pkl"


wildcard_constraints:
    pool="discovery|holdout",  # build_cohort corre por pool; el reparto train/val es aparte
    split="|".join(SPLITS),
    name="|".join(MODELS),
    seed=r"\d+",


# ── Endpoint por defecto ──
# Hoy el pipeline llega hasta los datos que consumen los modelos: un pickle de
# secuencias por split (issue 1). Cuando implementes los issues 2 a 5, el endpoint
# pasará a ser results/comparison.png, y descomentaras las lineas de abajo.
rule all:
    input:
        expand("results/{split}/sequences.pkl", split=SPLITS),
        "results/eda",
        expand("results/metrics/{name}.json", name=BASE_MODELS),
        "results/comparison.csv",
        "results/comparison.png",


# ── Reglas ──
include: "rules/ingest.smk"
include: "rules/eda.smk"
include: "rules/models.smk"
